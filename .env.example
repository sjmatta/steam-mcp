# Reference only: this server does not load .env files automatically.
# Set variables in your MCP client (for example, `claude mcp add -e`) or shell.

# Master switch for every mutation (collections, favorite/hidden, install/uninstall).
# Without it, all write tools return WRITES_DISABLED.
# STEAM_MCP_ALLOW_WRITES=1

# Ports probed for Steam's CEF debugger, in order. The first is also the port
# steam_restart asks Steam to bind (passed as -devtools-port when not 8080).
# Steam's own default is 8080; set this when something else holds that port.
# STEAM_DEBUG_PORT=8081

# Optional. Enables the full owned library and the wishlist while Steam is closed.
# Get one at https://steamcommunity.com/dev/apikey - any domain works for local use.
# STEAM_API_KEY=

# Optional overrides.
# STEAM_ACCOUNT_ID=<your userdata directory name>
# STEAM_MCP_CACHE_DIR=~/.cache/steam-mcp
